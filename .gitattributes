# Normalize line endings to LF in the repo; check out native on Windows.
* text=auto eol=lf

# Source code (always LF in the repo)
*.py     text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.sh     text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.html   text eol=lf

# Windows-only scripts keep CRLF
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binaries (no diff, no normalization)
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.svg    text eol=lf
*.pdf    binary
*.zip    binary
*.gz     binary
*.db     binary
*.sqlite binary
*.woff   binary
*.woff2  binary
