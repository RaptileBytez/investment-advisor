# ──────────────────────────────────────────────────────────────
# Python (backend)
# ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# Test / coverage / linting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.cache/

# ──────────────────────────────────────────────────────────────
# Node / frontend
# ──────────────────────────────────────────────────────────────
node_modules/
dist/
.vite/
coverage/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# ──────────────────────────────────────────────────────────────
# Databases & local data (NEVER commit these — may contain
# personal portfolio data)
# ──────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
backend/data/
backend/instance/

# ──────────────────────────────────────────────────────────────
# Secrets & local config
# ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ──────────────────────────────────────────────────────────────
# Editors / OS
# ──────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
.DS_Store
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
