# Copy to .env for local development. NEVER commit a real .env file.

# ── Database ────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/app.db

# ── Market-data provider ────────────────────────────────────
# Options: yfinance (default). Future: alpaca, finnhub, ibkr, …
DATA_PROVIDER=yfinance

# ── User defaults (used at first-run / onboarding) ──────────
BASE_CURRENCY=EUR
LOCALE=en

# ── Caching ─────────────────────────────────────────────────
CACHE_DIR=./data/cache
QUOTE_CACHE_TTL_SECONDS=60
HISTORY_CACHE_TTL_HOURS=24

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Server ──────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── Frontend origin for CORS (Vite default) ─────────────────
FRONTEND_ORIGIN=http://localhost:5173
